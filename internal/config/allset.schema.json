{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "repository",
    "backend"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "enum": [
        "allset.schema.json",
        "./allset.schema.json"
      ]
    },
    "version": {
      "const": 1
    },
    "name": {
      "$ref": "#/$defs/identifier",
      "description": "Stable project identity; does not select credentials by itself."
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "description": "owner/repo, Git SSH address, or HTTPS URL without credentials. Must match the installed profile. The CLI validates address syntax and inference uniqueness."
    },
    "backend": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "not": {
        "const": "box-herdr"
      },
      "description": "Compute service identifier, such as box. Use allset backends to list installed strategies; unsupported services never fall back to Box."
    },
    "mcps": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mcp"
      },
      "description": "Project-owned native MCP servers. Credentials use native login or remote environment references; never inline values. Omit to leave MCPs unmanaged, set {} to remove managed entries."
    },
    "skills": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/skill" },
      "description": "Repository-relative skill directories projected to selected native clients."
    },
    "session_environment": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/sessionVariable" },
      "description": "Named environment requirements supplied from the developer's private Infisical binding; values never belong here."
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "not": {
        "enum": [
          "help",
          "version",
          "projects",
          "config",
          "open",
          "resume",
          "connect",
          "status",
          "doctor",
          "login",
          "stop",
          "collect",
          "backends",
          "init",
          "mcp"
        ]
      }
    },
    "agent": { "enum": ["codex", "claude", "cursor"] },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "agents": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/agent" } }
      }
    },
    "sessionVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_path", "secret_key"],
      "properties": {
        "secret_path": { "type": "string", "pattern": "^/(?!.*\\.\\.).+" },
        "secret_key": { "type": "string", "minLength": 1 },
        "agents": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/agent" } },
        "mcps": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "const": "trigger"
        },
        "project_ref": {
          "type": "string",
          "pattern": "^proj_[a-zA-Z0-9]+$"
        },
        "read_only": {
          "type": "boolean",
          "default": true
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "env_vars": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          }
        },
        "bearer_token_env_var": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "oauth": {
          "const": true,
          "description": "Use each selected client's native OAuth login for this HTTP server."
        },
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "codex",
              "claude",
              "cursor"
            ]
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "preset",
            "project_ref"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "command"
                ]
              },
              {
                "required": [
                  "args"
                ]
              },
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "env_vars"
                ]
              },
              {
                "required": [
                  "bearer_token_env_var"
                ]
              },
              {
                "required": [
                  "oauth"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "command"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "preset"
                ]
              },
              {
                "required": [
                  "project_ref"
                ]
              },
              {
                "required": [
                  "read_only"
                ]
              },
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "bearer_token_env_var"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "url"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "preset"
                ]
              },
              {
                "required": [
                  "project_ref"
                ]
              },
              {
                "required": [
                  "read_only"
                ]
              },
              {
                "required": [
                  "command"
                ]
              },
              {
                "required": [
                  "args"
                ]
              },
              {
                "required": [
                  "env_vars"
                ]
              }
            ]
          },
          "allOf": [
            {
              "not": {
                "required": ["oauth", "bearer_token_env_var"]
              }
            }
          ]
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AllSet project config v1",
  "description": "Repository-owned entry point. Accounts and existing provider setup are bound locally. Terminal choice is not a project setting."
}
